# PydanticAI model identifier. Use "test" for an offline smoke test.
OASIS_MODEL=test

# For live multilingual map understanding, select a PydanticAI model and set
# that provider's API key, for example:
# OASIS_MODEL=openai:gpt-5-mini
# OPENAI_API_KEY=your_api_key_here

# Local OpenAI-compatible vLLM server (the API key can be any non-empty value):
# OASIS_MODEL_PROVIDER=vllm
# OASIS_MODEL=qwen3.8-27b
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1
# OPENAI_API_KEY=EMPTY

# Xiaomi MiMo through its OpenAI-compatible Chat Completions endpoint:
# OASIS_MODEL_PROVIDER=mimo
# OASIS_MODEL=mimo-v2.5-pro
# MIMO_API_KEY=your_mimo_api_key_here
# For pay-as-you-go keys: https://api.xiaomimimo.com/v1
# For Token Plan keys, use the exact Base URL shown in the MiMo console.
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# HTTP settings for the public SEPA time-series service.
OASIS_HTTP_TIMEOUT_SECONDS=30
OASIS_USER_AGENT=oasis-geoagent/0.1

# Default first-version study area.
OASIS_DEFAULT_AREA=glasgow

# Latest calculated 5 m hazard raster published through local GeoServer.
OASIS_GEOSERVER_WMS_URL=http://127.0.0.1:8080/geoserver/glasgow_flood/wms
OASIS_GEOSERVER_REST_URL=http://127.0.0.1:8080/geoserver/rest
OASIS_GEOSERVER_USER=admin
OASIS_GEOSERVER_PASSWORD=geoserver
OASIS_CURRENT_HAZARD_LAYER=glasgow_flood:current_hazard_class_5m
OASIS_CURRENT_HAZARD_RASTER_PATH=webgis/.runtime/data_dir/data/glasgow_flood/current_hazard_class_5m/current_hazard_class_5m.geotiff
OASIS_CURRENT_HAZARD_OUTPUT_DIR=analysis/core-analyst/outputs/current
OASIS_CORE_ANALYST_INPUT_DIR=analysis/core-analyst/Input
OASIS_CORE_ANALYST_CONFIG_PATH=analysis/core-analyst/config/pluvial_prediction_config.yaml
OASIS_CORE_ANALYST_CONFIG_DIR=analysis/core-analyst/config
OASIS_CORE_ANALYST_ANALYSIS_OUTPUT_DIR=analysis/core-analyst/outputs/agent
# Required only when all-hazards runs use live future rainfall.
# METOFFICE_SITE_API_KEY=your_metoffice_site_specific_key
# Required only for live coastal tidal prediction. The data rebuild does not use it.
# ADMIRALTY_API_KEY=your_admiralty_tidal_api_key
OASIS_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OASIS_OSRM_URL=https://router.project-osrm.org
