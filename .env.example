# PydanticAI model identifier. Use "test" for an offline smoke test.
HYDROMIND_MODEL=test

# For live multilingual map understanding, select a PydanticAI model and set
# that provider's API key, for example:
# HYDROMIND_MODEL=openai:gpt-5-mini
# OPENAI_API_KEY=your_api_key_here

# Local OpenAI-compatible vLLM server (the API key can be any non-empty value):
# HYDROMIND_MODEL_PROVIDER=vllm
# HYDROMIND_MODEL=qwen3.8-27b
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1
# OPENAI_API_KEY=EMPTY

# Xiaomi MiMo through its OpenAI-compatible Chat Completions endpoint:
# HYDROMIND_MODEL_PROVIDER=mimo
# HYDROMIND_MODEL=mimo-v2.5-pro
# MIMO_API_KEY=your_mimo_api_key_here
# For pay-as-you-go keys: https://api.xiaomimimo.com/v1
# For Token Plan keys, use the exact Base URL shown in the MiMo console.
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# HTTP settings for the public SEPA time-series service.
HYDROMIND_HTTP_TIMEOUT_SECONDS=30
HYDROMIND_USER_AGENT=hydromind-geoagent/0.1
# Shared Met Office SiteSpecific sampling grid: 5 means 5x5 = 25 API points.
HYDROMIND_METOFFICE_SAMPLE_GRID_SIZE=5

# Default first-version study area.
HYDROMIND_DEFAULT_AREA=glasgow

# Latest calculated 5 m hazard raster published through local GeoServer.
HYDROMIND_GEOSERVER_WMS_URL=http://127.0.0.1:8080/geoserver/glasgow_flood/wms
HYDROMIND_GEOSERVER_REST_URL=http://127.0.0.1:8080/geoserver/rest
HYDROMIND_GEOSERVER_USER=admin
HYDROMIND_GEOSERVER_PASSWORD=geoserver
HYDROMIND_CURRENT_HAZARD_LAYER=glasgow_flood:current_hazard_class_5m
HYDROMIND_CURRENT_HAZARD_RASTER_PATH=webgis/.runtime/data_dir/data/glasgow_flood/current_hazard_class_5m/current_hazard_class_5m.geotiff
HYDROMIND_CURRENT_HAZARD_OUTPUT_DIR=analysis/core-analyst/outputs/current
HYDROMIND_CORE_ANALYST_INPUT_DIR=data/Input
HYDROMIND_CORE_ANALYST_CONFIG_PATH=analysis/core-analyst/config/pluvial_prediction_config.yaml
HYDROMIND_CORE_ANALYST_CONFIG_DIR=analysis/core-analyst/config
HYDROMIND_CORE_ANALYST_ANALYSIS_OUTPUT_DIR=analysis/core-analyst/outputs/agent
# Website startup can automatically build missing data after these two values
# are explicitly configured. The path must point to the licensed source TIFF.
# HYDROMIND_LCM2019_PATH=/absolute/path/to/gb2019lcm25m.tif
# HYDROMIND_ACCEPT_DATA_LICENCES=true
HYDROMIND_AUTO_PREPARE_DATA=true
# Required only when all-hazards runs use live future rainfall.
# METOFFICE_SITE_API_KEY=your_metoffice_site_specific_key
# Required only for live coastal tidal prediction. The data rebuild does not use it.
# ADMIRALTY_API_KEY=your_admiralty_tidal_api_key
# Historical UKV validation. Prefer a local UKV GRIB file or directory; CEDA
# credentials are only needed if the archive must be downloaded at runtime.
# CEDA_ACCESS_TOKEN=your_short_lived_ceda_token
# CEDA_USERNAME=your_ceda_username
# CEDA_PASSWORD=your_ceda_password
# HYDROMIND_HISTORICAL_UKV_PATH=/absolute/path/to/ukv_202310
HYDROMIND_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
HYDROMIND_OSRM_URL=https://router.project-osrm.org
